{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Docker Container",
      "type": "shell",
      //building image (named dragonblight_backend)
      "command": "docker build -t dragonblight_backend -f ./Dragonblight_Website.Server/dockerfile .",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Remove Old Docker Container",
      "problemMatcher": []
    },
    {
      "label": "Remove Old Docker Container",
      "type": "shell",
      //even if there is an error with the command, run anyways
      "command": "docker rm -f dragonblight_backend_container || true",
      "dependsOn": "Stop Docker Container",
      "problemMatcher": []
    },
    {
      "label": "Stop Docker Container",
      "type": "shell",
      //even if there is an error with the command, run anyways
      "command": "docker stop dragonblight_backend_container || true",
      "problemMatcher": []
    },
    {
      "label": "Run Docker",
      "type": "shell",
      //inside the docker network postgres is reached by container name, not the localhost in .env
      "command": "docker compose up -d --wait && set -a && . ./.env && set +a; docker rm -f dragonblight_backend_container || true; docker run -d --name dragonblight_backend_container --network dragonblight-network -p 8080:8080 -p 7054:7054 --env ASPNETCORE_ENVIRONMENT=Development --env DOTNET_USE_POLLING_FILE_WATCHER=1 --env Redis__ConnectionString=dragonblight_redis_container:6379 --env \"ConnectionStrings__Postgres=Host=dragonblight_postgres_container;Database=dragonblight;Username=dragonblight;Password=$POSTGRES_PASSWORD\" dragonblight_backend",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Build Docker Container",
      "problemMatcher": []
    },
    {
      "label": "Build and Run",
      "dependsOn": [
        "Stop Docker Container",
        "Remove Old Docker Container",
        "Build Docker Container",
        "Run Docker"
      ],
      "problemMatcher": []
    },
    {
      //redis and postgres from docker-compose.yml, on named volumes so their data survives a restart.
      //Containers already running are left alone, and --wait holds until both pass their healthchecks
      "label": "Local: Docker Compose",
      "type": "shell",
      "command": "docker compose up -d --wait",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      //compiles the backend before the debugger launches it, so a launch always runs the current
      //code rather than whatever the last manual build left in bin
      "label": "Local: Build Backend",
      "type": "shell",
      "command": "dotnet build Dragonblight_Website.Server",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Local: Docker Compose",
      "problemMatcher": "$msCompile"
    },
    {
      //the backend on the host rather than in a container, so redis and postgres are reached on localhost.
      //no launch profile: the http profile loads the spa proxy, which would start the frontend too
      "label": "Local: Backend",
      "type": "shell",
      "command": "set -a && . ./.env && set +a && dotnet run --no-launch-profile --project Dragonblight_Website.Server",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DOTNET_ROLL_FORWARD": "LatestMajor",
          "ASPNETCORE_ENVIRONMENT": "Development",
          "ASPNETCORE_URLS": "http://localhost:5059",
          "Redis__ConnectionString": "localhost:6379"
        }
      },
      "dependsOn": "Local: Docker Compose",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^\\s*(.*)$",
          "file": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Building\\.\\.\\..*$",
          "endsPattern": "^.*Now listening on.*$"
        }
      }
    },
    {
      //vite is already a watch server; the client proxies /api to localhost:5059
      "label": "Local: Frontend",
      //a shell task, not an npm one: vscode identifies npm tasks by script and path, so this would
      //share an identity with "npm run dev" above and only one of the two would show in the picker
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/dragonblight_website.client"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^\\s*(.*)$",
          "file": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*VITE.*$",
          "endsPattern": "^.*ready in.*$"
        }
      }
    },
    {
      "label": "Local: Run All",
      "dependsOn": [
        "Local: Docker Compose",
        "Local: Backend",
        "Local: Frontend"
      ],
      "problemMatcher": []
    },
    {
      //will be running for frontend
      "label": "npm run dev",
      "type": "npm",
      "script": "dev",
      "path": "dragonblight_website.client",
      "problemMatcher": "$tsc",
      "isBackground": true
    }
  ]
}