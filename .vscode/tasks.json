{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Docker Container",
      "type": "shell",
      //building image (named dragonblight_backend)
      "command": "docker build -t dragonblight_backend -f ./Dragonblight_Website.Server/dockerfile .",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Remove Old Docker Container",
      "problemMatcher": []
    },
    {
      "label": "Remove Old Docker Container",
      "type": "shell",
      //even if there is an error with the command, run anyways
      "command": "docker rm -f dragonblight_backend_container || true",
      "dependsOn": "Stop Docker Container",
      "problemMatcher": []
    },
    {
      "label": "Stop Docker Container",
      "type": "shell",
      //even if there is an error with the command, run anyways
      "command": "docker stop dragonblight_backend_container || true",
      "problemMatcher": []
    },
    {
      "label": "Run Docker",
      "type": "shell",
      "command": "docker network inspect dragonblight-network >/dev/null 2>&1 || docker network create dragonblight-network; docker ps --format '{{.Names}}' | grep -qx dragonblight_redis_container || { docker start dragonblight_redis_container 2>/dev/null || docker run -d --name dragonblight_redis_container --network dragonblight-network -p 6379:6379 -v dragonblight_redis_data:/data --restart unless-stopped redis:7-alpine redis-server --appendonly yes; }; until docker exec dragonblight_redis_container redis-cli ping 2>/dev/null | grep -q PONG; do echo 'Waiting for Redis...'; sleep 1; done; echo 'Redis ready'; docker rm -f dragonblight_backend_container || true; docker run -d --name dragonblight_backend_container --network dragonblight-network -p 8080:8080 -p 7054:7054 --env ASPNETCORE_ENVIRONMENT=Development --env DOTNET_USE_POLLING_FILE_WATCHER=1 --env Redis__ConnectionString=dragonblight_redis_container:6379 dragonblight_backend",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Build Docker Container",
      "problemMatcher": []
    },
    {
      "label": "Build and Run",
      "dependsOn": [
        "Stop Docker Container",
        "Remove Old Docker Container",
        "Build Docker Container",
        "Run Docker"
      ],
      "problemMatcher": []
    },
    {
      //redis in docker with a named volume, so the cache and the alt lists survive a restart
      //instead of starting empty on a fresh anonymous volume. A container that is already running
      //is left alone - restarting it is what threw the data away
      "label": "Local: Redis",
      "type": "shell",
      "command": "docker network inspect dragonblight-network >/dev/null 2>&1 || docker network create dragonblight-network; docker ps --format '{{.Names}}' | grep -qx dragonblight_redis_container || { docker start dragonblight_redis_container 2>/dev/null || docker run -d --name dragonblight_redis_container --network dragonblight-network -p 6379:6379 -v dragonblight_redis_data:/data --restart unless-stopped redis:7-alpine redis-server --appendonly yes; }; until docker exec dragonblight_redis_container redis-cli ping 2>/dev/null | grep -q PONG; do echo 'Waiting for Redis...'; sleep 1; done; echo 'Redis ready'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      //compiles the backend before the debugger launches it, so a launch always runs the current
      //code rather than whatever the last manual build left in bin
      "label": "Local: Build Backend",
      "type": "shell",
      "command": "dotnet build Dragonblight_Website.Server",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Local: Redis",
      "problemMatcher": "$msCompile"
    },
    {
      //the backend on the host rather than in a container, so redis is reached on localhost.
      //no launch profile: the http profile loads the spa proxy, which would start the frontend too
      "label": "Local: Backend",
      "type": "shell",
      "command": "dotnet run --no-launch-profile --project Dragonblight_Website.Server",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DOTNET_ROLL_FORWARD": "LatestMajor",
          "ASPNETCORE_ENVIRONMENT": "Development",
          "ASPNETCORE_URLS": "http://localhost:5059",
          "Redis__ConnectionString": "localhost:6379"
        }
      },
      "dependsOn": "Local: Redis",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^\\s*(.*)$",
          "file": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Building\\.\\.\\..*$",
          "endsPattern": "^.*Now listening on.*$"
        }
      }
    },
    {
      //vite is already a watch server; the client proxies /api to localhost:5059
      "label": "Local: Frontend",
      //a shell task, not an npm one: vscode identifies npm tasks by script and path, so this would
      //share an identity with "npm run dev" above and only one of the two would show in the picker
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/dragonblight_website.client"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^\\s*(.*)$",
          "file": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*VITE.*$",
          "endsPattern": "^.*ready in.*$"
        }
      }
    },
    {
      "label": "Local: Run All",
      "dependsOn": [
        "Local: Redis",
        "Local: Backend",
        "Local: Frontend"
      ],
      "problemMatcher": []
    },
    {
      //will be running for frontend
      "label": "npm run dev",
      "type": "npm",
      "script": "dev",
      "path": "dragonblight_website.client",
      "problemMatcher": "$tsc",
      "isBackground": true
    }
  ]
}